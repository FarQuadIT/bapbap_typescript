<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/custom_game_setup.css" />
    </styles>

    <scripts>
        <include src="file://{resources}/scripts/custom_game/game_setup.js" />
    </scripts>

    <Panel class="GameSetupRoot" hittest="true" hittestchildren="true">
        <Label id="SetupLabel" text="Загрузка игры..." />
        
        <Label id="TeamLabel" text="Вы будете автоматически распределены в команду" />
        
        <!-- Таймер автостарта -->
        <Label id="AutoStartTimer" html="true" text="Игра начнется автоматически через <font color='#FFD700'>15</font> сек." />
        
        <!-- Кнопка "Начать игру" (только для лидера лобби) -->
        <Panel id="SetupBottomContainer">
            <Button id="SetupStartButton" onactivate="OnSetupStartClicked()">
                <Label text="Начать игру" />
            </Button>
            <Label id="WaitingForLeaderLabel" text="Ожидание решения лидера лобби..." />
        </Panel>
    </Panel>
</root>
