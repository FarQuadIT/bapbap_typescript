<root>
    <styles>
        <include src="file://{resources}/styles/custom_game/custom_game_setup.css" />
    </styles>

    <scripts>
        <include src="file://{resources}/scripts/custom_game/game_setup.js" />
    </scripts>

    <Panel class="GameSetupRoot" hittest="true" hittestchildren="true">
        <!-- ОВЕРЛЕИ СВЕЧЕНИЯ (под контентом) -->
        <Panel id="GlowOverlayBottomLeft" class="GlowOverlay" hittest="false" />
        <Panel id="GlowOverlayTopRight" class="GlowOverlay" hittest="false" />
        
        <!-- Контейнер всего контента (поверх оверлеев) -->
        <Panel id="ContentContainer">
            <!-- Логотип В САМОМ ВЕРХУ -->
            <Image id="Logo" src="file://{images}/custom_game/loading_screen/logo.png" />
            
            <!-- Электричество под логотипом (анимация через JavaScript) -->
            <Image id="ElectricEffect" src="file://{images}/custom_game/electric/frame_00001.png" />
            
            <!-- Скрытая панель для предзагрузки 31 кадра (каждый 12-й) -->
            <Panel id="PreloadElectricFrames" />
            
            <!-- Скрытая панель для предзагрузки взрывов (34 кадра) -->
            <Panel id="PreloadExplosionFrames" />
            
            <!-- Контейнер панелей игроков (панели создаются динамически через JavaScript) -->
            <Panel id="PlayersContainer"></Panel>
            
            <!-- Круговой таймер автостарта -->
            <Panel id="CircularTimerContainer">
                <Panel id="CircularTimerBackground" />
                <Panel id="CircularTimerProgress" />
                <Label id="CircularTimerText" text="10" />
            </Panel>
            
            <!-- Кнопка "Начать игру" (только для лидера лобби) -->
            <Panel id="SetupBottomContainer">
                <Button id="SetupStartButton" onactivate="OnSetupStartClicked()">
                    <Label text="Начать игру" />
                </Button>
                <Label id="WaitingForLeaderLabel" text="Ожидание решения лидера лобби..." />
            </Panel>
        </Panel>
        
        <!-- 🎮 ВЫБОР ГЕРОЕВ (скрыт по умолчанию, показывается после интро) -->
        <Panel id="HeroSelectionContainer" class="HeroSelectionRoot">
            <!-- ВЕРХНЯЯ ПАНЕЛЬ: Очередь пика (8 слотов) -->
            <Panel id="PickOrderPanel">
                <Panel id="PickSlot_0" class="PickSlot">
                    <Panel id="PickSlotHero_0" class="PickSlotHeroContainer" />
                    <Label id="PickSlotTimer_0" class="PickSlotTimer" text="" />
                </Panel>
                <Panel id="PickSlot_1" class="PickSlot">
                    <Panel id="PickSlotHero_1" class="PickSlotHeroContainer" />
                    <Label id="PickSlotTimer_1" class="PickSlotTimer" text="" />
                </Panel>
                <Panel id="PickSlot_2" class="PickSlot">
                    <Panel id="PickSlotHero_2" class="PickSlotHeroContainer" />
                    <Label id="PickSlotTimer_2" class="PickSlotTimer" text="" />
                </Panel>
                <Panel id="PickSlot_3" class="PickSlot">
                    <Panel id="PickSlotHero_3" class="PickSlotHeroContainer" />
                    <Label id="PickSlotTimer_3" class="PickSlotTimer" text="" />
                </Panel>
                <Panel id="PickSlot_4" class="PickSlot">
                    <Panel id="PickSlotHero_4" class="PickSlotHeroContainer" />
                    <Label id="PickSlotTimer_4" class="PickSlotTimer" text="" />
                </Panel>
                <Panel id="PickSlot_5" class="PickSlot">
                    <Panel id="PickSlotHero_5" class="PickSlotHeroContainer" />
                    <Label id="PickSlotTimer_5" class="PickSlotTimer" text="" />
                </Panel>
                <Panel id="PickSlot_6" class="PickSlot">
                    <Panel id="PickSlotHero_6" class="PickSlotHeroContainer" />
                    <Label id="PickSlotTimer_6" class="PickSlotTimer" text="" />
                </Panel>
                <Panel id="PickSlot_7" class="PickSlot">
                    <Panel id="PickSlotHero_7" class="PickSlotHeroContainer" />
                    <Label id="PickSlotTimer_7" class="PickSlotTimer" text="" />
                </Panel>
            </Panel>
            
            <!-- ОСНОВНОЙ КОНТЕНТ: 3 колонки -->
            <Panel id="MainContent">
                <!-- ЛЕВАЯ КОЛОНКА: Список героев (40%) -->
                <Panel id="LeftColumn">
                    <Label id="HeroListTitle" text="ВЫБЕРИ ГЕРОЯ:" />
                    <Panel id="HeroListContainer">
                        <Panel class="HeroCard" data-hero="npc_dota_hero_axe">
                            <Image class="HeroCardImage" />
                            <Label class="HeroCardName" text="Axe" />
                        </Panel>
                        <Panel class="HeroCard" data-hero="npc_dota_hero_pudge">
                            <Image class="HeroCardImage" />
                            <Label class="HeroCardName" text="Pudge" />
                        </Panel>
                        <Panel class="HeroCard" data-hero="npc_dota_hero_crystal_maiden">
                            <Image class="HeroCardImage" />
                            <Label class="HeroCardName" text="Crystal Maiden" />
                        </Panel>
                    </Panel>
                </Panel>
                
                <!-- ЦЕНТРАЛЬНАЯ КОЛОНКА: Информация о герое (35%) -->
                <Panel id="CenterColumn">
                    <Label id="CenterColumnPlaceholder" text="ИНФОРМАЦИЯ О ГЕРОЕ" />
                    <Panel id="SelectButtonContainer">
                        <Button id="SelectHeroButton" class="SelectButton">
                            <Label text="ВЫБРАТЬ" />
                        </Button>
                    </Panel>
                </Panel>
                
                <!-- ПРАВАЯ КОЛОНКА: Аугментации (25%) -->
                <Panel id="RightColumn">
                    <Label id="RightColumnPlaceholder" text="АУГМЕНТАЦИИ" />
                </Panel>
            </Panel>
        </Panel>
    </Panel>
</root>
