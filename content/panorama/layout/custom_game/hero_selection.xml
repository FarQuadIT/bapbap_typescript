        <!-- ========================================
             ВЕРХНЯЯ ПАНЕЛЬ: Очередь пика (8 слотов)
             ======================================== -->
        <Panel id="PickOrderPanel">
            <!-- Слот 1 -->
            <Panel class="PickSlot">
                <Image class="PickSlotAvatar" src="file://{images}/custom_game/tstl.png" />
                <Label class="PickSlotTimer" text="" />
            </Panel>
            
            <!-- Слот 2 -->
            <Panel class="PickSlot">
                <Image class="PickSlotAvatar" src="file://{images}/custom_game/tstl.png" />
                <Label class="PickSlotTimer" text="" />
            </Panel>
            
            <!-- Слот 3 -->
            <Panel class="PickSlot">
                <Image class="PickSlotAvatar" src="file://{images}/custom_game/tstl.png" />
                <Label class="PickSlotTimer" text="" />
            </Panel>
            
            <!-- Слот 4 -->
            <Panel class="PickSlot">
                <Image class="PickSlotAvatar" src="file://{images}/custom_game/tstl.png" />
                <Label class="PickSlotTimer" text="" />
            </Panel>
            
            <!-- Слот 5 -->
            <Panel class="PickSlot">
                <Image class="PickSlotAvatar" src="file://{images}/custom_game/tstl.png" />
                <Label class="PickSlotTimer" text="" />
