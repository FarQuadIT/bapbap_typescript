<root>
    <!-- Подключение стилей -->
    <styles>
        <include src="file://{resources}/styles/custom_game/hero_selection.css" />
    </styles>

    <!-- Подключение скриптов (компилированный JS из TypeScript) -->
    <scripts>
        <include src="file://{resources}/scripts/custom_game/hero_selection.js" />
    </scripts>

    <!-- Корневая панель экрана выбора героев (БЕЗ id - это корневая!) -->
